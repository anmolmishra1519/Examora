# Copy this file to .env and adjust for your environment.

APP_NAME=Examora
ENV=development

# SQLite works out of the box for local dev/demo. For production, point this
# at a real Postgres instance - every model uses SQLAlchemy's ORM so no code
# changes are required:
#   DATABASE_URL=postgresql://examora:examora@localhost:5432/examora
DATABASE_URL=sqlite:///./examora.db

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# "rules" = built-in deterministic document parser, no API key required.
# "llm" = route document understanding through an LLM (requires AI_API_KEY
# and wiring app/ai/llm_provider.py to your provider of choice).
AI_PROVIDER=rules
AI_API_KEY=

# "live" only records real events reported by the browser's detection
# engine. "demo" additionally seeds deterministic sample events for
# screenshots/demos - see app/seed.py.
PROCTORING_MODE=live

STORAGE_PROVIDER=local
STORAGE_PATH=./uploads

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

MAX_UPLOAD_MB=20
